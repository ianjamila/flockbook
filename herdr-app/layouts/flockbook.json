{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    18,
    22
  ],
  "background": "canvas",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 250
      },
      "min": 220,
      "max": 320,
      "hidden": true,
      "background": "chrome",
      "divider": {
        "width": 1,
        "color": "border"
      },
      "children": [
        {
          "id": "side",
          "type": "block",
          "content": {
            "mod": "flockbook",
            "props": {
              "view": "side"
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "screen",
          "type": "stack",
          "active": "chat",
          "children": [
            {
              "id": "chat",
              "type": "column",
              "resizable": false,
              "children": [
                {
                  "id": "chat-top",
                  "type": "block",
                  "size": {
                    "px": 56
                  },
                  "window_drag": true,
                  "content": {
                    "mod": "flockbook",
                    "props": {
                      "view": "top"
                    }
                  }
                },
                {
                  "id": "chat-body",
                  "type": "block",
                  "content": {
                    "mod": "flockbook",
                    "props": {
                      "view": "chat",
                      "bar": "outside"
                    }
                  }
                }
              ]
            },
            {
              "id": "needs",
              "type": "column",
              "resizable": false,
              "children": [
                {
                  "id": "needs-top",
                  "type": "block",
                  "size": {
                    "px": 56
                  },
                  "window_drag": true,
                  "content": {
                    "mod": "flockbook",
                    "props": {
                      "view": "top"
                    }
                  }
                },
                {
                  "id": "needs-body",
                  "type": "block",
                  "content": {
                    "mod": "flockbook",
                    "props": {
                      "view": "needs",
                      "bar": "outside"
                    }
                  }
                }
              ]
            },
            {
              "id": "overview",
              "type": "column",
              "resizable": false,
              "children": [
                {
                  "id": "overview-top",
                  "type": "block",
                  "size": {
                    "px": 56
                  },
                  "window_drag": true,
                  "content": {
                    "mod": "flockbook",
                    "props": {
                      "view": "top"
                    }
                  }
                },
                {
                  "id": "overview-body",
                  "type": "block",
                  "content": {
                    "mod": "flockbook",
                    "props": {
                      "view": "overview",
                      "bar": "outside"
                    }
                  }
                }
              ]
            },
            {
              "id": "tab",
              "type": "column",
              "children": [
                {
                  "id": "top",
                  "type": "block",
                  "size": {
                    "px": 56
                  },
                  "window_drag": true,
                  "content": {
                    "mod": "flockbook",
                    "props": {
                      "view": "top"
                    }
                  }
                },
                {
                  "id": "tab-panes",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 6,
                      "radius": 8,
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "muted"
                      }
                    }
                  },
                  "padding": 8
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "tablist",
      "type": "column",
      "size": {
        "px": 250
      },
      "min": 180,
      "max": 420,
      "resizable": false,
      "background": "chrome",
      "children": [
        {
          "id": "tabs-top",
          "type": "block",
          "size": {
            "px": 56
          },
          "window_drag": true,
          "content": {
            "mod": "flockbook",
            "props": {
              "view": "tabs",
              "part": "head"
            }
          }
        },
        {
          "id": "tabs-body",
          "type": "block",
          "content": {
            "mod": "flockbook",
            "props": {
              "view": "tabs",
              "part": "list"
            }
          }
        }
      ]
    }
  ],
  "theme": {
    "light": "flockbook-light",
    "dark": "flockbook"
  }
}
